---
import { type Locale, site } from '../../config/site';
import { useT } from '../../i18n';
import { getShows } from './data';
import TourList from './TourList.svelte';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const { upcoming, past } = await getShows(locale);
---

<section class="mx-auto max-w-[1440px] px-4 pt-36 pb-28 sm:px-8 lg:pt-44">
  <h1 class="display reveal text-[clamp(4.5rem,15vw,13rem)]">{t('nav.tour')}</h1>
  <p class="reveal mt-6 max-w-2xl text-xl" style="--d:80ms">{t('tour.lede')}</p>
  <div class="reveal mt-10" style="--d:120ms">
    <TourList client:visible shows={upcoming} locale={locale} />
  </div>

  <div class="mt-28 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <h2 class="display text-[clamp(2.5rem,5vw,4.5rem)]">{t('tour.past')}</h2>
      <!-- Static: past shows need no filter, so no hydration. -->
      <TourList shows={past} locale={locale} past />
    </div>
    <div class="lg:col-span-5 lg:col-start-8">
      <h2 class="display text-[clamp(2.5rem,5vw,4.5rem)]">{t('tour.notify')}</h2>
      <div class="glass-strong mt-6 rounded-3xl p-7">
        <p class="text-xl">{t('tour.notifyP')}</p>
        <a
          target="_blank"
          rel="noopener"
          href={site.whatsapp.channelUrl}
          class="press mt-6 inline-block rounded-full bg-acid px-7 py-4 font-semibold text-on-acid hover:bg-ink hover:text-ground"
          >{t('channel.cta')}</a
        >
      </div>
    </div>
  </div>
</section>
