---
import type { Locale } from '../../config/site';
import { useT } from '../../i18n';
import { getReleases, releaseLinks } from './data';
import ReleaseGrid from './ReleaseGrid.svelte';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const releases = (await getReleases()).map((r) => ({ ...r, links: releaseLinks(r) }));
---

<section class="mx-auto max-w-[1440px] px-4 pt-36 pb-28 sm:px-8 lg:pt-44">
  <h1 class="display reveal text-[clamp(4.5rem,15vw,13rem)]">{t('nav.music')}</h1>
  <p class="reveal mt-6 max-w-2xl text-xl" style="--d:80ms">{t('music.lede')}</p>
  <ReleaseGrid client:visible releases={releases} locale={locale} />
</section>
