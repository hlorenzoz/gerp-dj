---
import { site } from '../config/site';
import { getLocale, localizePath, useT } from '../i18n';
import { waLink } from '../lib/whatsapp';
import { navLinks } from './nav';

const locale = getLocale(Astro.currentLocale);
const t = useT(locale);
---

<footer class="mt-10 pb-10">
  <div class="mx-auto max-w-[1440px] px-4 sm:px-8">
    <div class="glass grid gap-10 rounded-3xl p-7 sm:p-10 lg:grid-cols-12">
      <nav aria-label={t('aria.navFooter')} class="grid gap-2 lg:col-span-3">
        {navLinks(locale, 'footer').map((link) => <a href={link.href} class="hover:text-acid-ink">{link.label}</a>)}
      </nav>
      {
        site.features.socials && (
          <ul class="grid gap-2 lg:col-span-3" aria-label={t('aria.socials')}>
            {site.socials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" class="hover:text-acid-ink">{s.name}</a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="grid h-fit gap-2 lg:col-span-5 lg:col-start-8">
        <p class="text-lg font-semibold">WhatsApp Business</p>
        <a href={waLink()} target="_blank" rel="noopener" class="display text-3xl text-acid-ink hover:text-ink">{site.whatsapp.display}</a>
        <p class="text-muted">{t('c.hours')}</p>
      </div>
    </div>
    <p class="display mt-10 text-center text-[min(calc((100vw-4rem)/5.9),14.5rem)] leading-[0.8]" aria-hidden="true">GERP DJ</p>
    <div class="mt-6 flex flex-wrap justify-between gap-4 text-sm text-muted">
      <span>{t('footer.copy')}</span>
      <span
        ><a href={localizePath('/privacidad', locale)} class="hover:text-ink">{t('legal.privacy')}</a> · <a
          href={localizePath('/cookies', locale)}
          class="hover:text-ink">{t('legal.cookies')}</a
        ></span
      >
    </div>
  </div>
</footer>
