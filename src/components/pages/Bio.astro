---
import Picture from '../Picture.astro';
import { site, type Locale } from '../../config/site';
import { localizePath, useT } from '../../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
const quarter = '(min-width: 1024px) 25vw, 50vw';
---

<section class="mx-auto max-w-[1440px] px-4 pt-36 pb-28 sm:px-8 lg:pt-44">
  <h1 class="display text-[clamp(4.5rem,15vw,13rem)]">{t('nav.bio')}</h1>
  <div class="mt-12 grid gap-10 lg:grid-cols-12">
    <div class="space-y-6 text-xl lg:col-span-7">
      <p class="reveal">{t('about.p1')}</p>
      <p class="reveal" style="--d:70ms">{t('about.story')}</p>
      <p class="reveal" style="--d:140ms">{t('bio.p2')}</p>
      <p class="reveal" style="--d:210ms">{t('bio.p3')}</p>
      <a
        href={localizePath('/contratacion', locale)}
        class="press reveal inline-block rounded-full bg-acid px-7 py-4 text-base font-semibold text-on-acid hover:bg-ink hover:text-ground"
        style="--d:280ms">{t('band.cta')}</a
      >
    </div>
    <aside class="glass-strong reveal h-fit rounded-3xl p-7 lg:col-span-4 lg:col-start-9" style="--d:120ms" aria-labelledby="press-h">
      <h2 id="press-h" class="text-2xl font-bold">{t('press.title')}</h2>
      <p class="mt-3 text-muted">{t('press.placeholder')}</p>
      <a
        href={site.press.pdf(locale)}
        target="_blank"
        rel="noopener"
        class="press mt-6 block rounded-full bg-acid px-6 py-3 text-center font-semibold text-on-acid hover:bg-ink hover:text-ground">{t('press.kit')}</a
      >
      <!-- Placeholder until the client provides a high-resolution photo pack. -->
      <a href="#" class="press glass-subtle mt-3 block rounded-full px-6 py-3 text-center font-semibold hover:bg-ink hover:text-ground"
        >{t('press.photos')}</a
      >
    </aside>
  </div>
  <h2 class="display mt-28 text-[clamp(2.5rem,5vw,4.5rem)]">{t('bio.gallery')}</h2>
  <div class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
    <div class="reveal lg:row-span-2">
      <Picture
        name="gerp-dj-ourense-retrato-equipo-sonido"
        alt={t('about.alt')}
        sizes={quarter}
        class="aspect-[4/5] w-full rounded-3xl object-cover object-top lg:aspect-auto lg:h-full"
      />
    </div>
    <div class="reveal">
      <Picture name="gerp-dj-ourense-controladora-denon-dj" alt={t('svc.alt')} sizes={quarter} class="aspect-square w-full rounded-3xl object-cover" />
    </div>
    <div class="reveal">
      <Picture name="gerp-dj-ourense-cabina-iluminacion-led" alt={t('kit.alt')} sizes={quarter} class="aspect-square w-full rounded-3xl object-cover" />
    </div>
    <div class="reveal">
      <Picture name="gerp-dj-luces-fiesta-ourense" alt={t('gal.alt')} sizes={quarter} class="aspect-square w-full rounded-3xl object-cover" />
    </div>
    <div class="reveal">
      <Picture name="gerp-dj-fiesta-aldea-ourense" alt={t('action.alt2')} sizes={quarter} class="aspect-square w-full rounded-3xl object-cover" />
    </div>
    <div class="reveal col-span-2 lg:col-span-3">
      <Picture
        name="gerp-dj-sesion-terraza-ourense"
        alt={t('gal.alt2')}
        sizes="(min-width: 1024px) 75vw, 100vw"
        class="aspect-[16/9] w-full rounded-3xl object-cover"
      />
    </div>
  </div>
</section>
