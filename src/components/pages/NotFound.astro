---
import { localizePath, useT } from '../../i18n';

// One static 404 for both locales: Spanish first, with the Galician line beneath.
const es = useT('es');
const gl = useT('gl');
---

<section class="mx-auto max-w-[1440px] px-4 pt-36 pb-28 sm:px-8 lg:pt-44">
  <p class="display text-acid-ink text-[clamp(5rem,18vw,14rem)]" aria-hidden="true">404</p>
  <h1 class="display mt-6 text-[clamp(2.5rem,6vw,5rem)]">{es('404.title')}</h1>
  <p class="mt-6 max-w-2xl text-xl">{es('404.p')}</p>
  <p class="mt-2 max-w-2xl text-xl text-muted" lang="gl">{gl('404.title')}. {gl('404.p')}</p>
  <div class="mt-10 flex flex-wrap gap-3">
    <a href={localizePath('/', 'es')} class="press rounded-full bg-acid px-7 py-4 font-semibold text-on-acid hover:bg-ink hover:text-ground">{es('404.home')}</a>
    <a href={localizePath('/', 'gl')} lang="gl" class="press glass-subtle rounded-full px-7 py-4 font-semibold hover:bg-ink hover:text-ground"
      >{gl('404.home')}</a
    >
  </div>
</section>
