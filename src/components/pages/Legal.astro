---
import type { Locale } from '../../config/site';
import { type Key, useT } from '../../i18n';

// Shared frame for Privacidad and Cookies: full-width heading, then the prose (`.legal` in global.css).
const { locale, title } = Astro.props as { locale: Locale; title: Key };
const t = useT(locale);
---

<section class="mx-auto max-w-[1440px] px-4 pt-36 pb-28 sm:px-8 lg:pt-44">
  <!-- shortcut: size fitted to the longest title, "Privacidade" (~7.1em in Archivo 125/850); refit if a longer title is added -->
  <h1 class="display text-[min(calc((100vw-4rem)/7.4),10rem)]">{t(title)}</h1>
  <article class="legal glass-strong mt-12 max-w-4xl rounded-3xl p-7 sm:p-10">
    <slot />
  </article>
</section>
