---
import type { Locale } from '../../config/site';
import { useT, type Key } from '../../i18n';

// Shared frame for Privacidad and Cookies: heading + draft note, prose (`.legal` in global.css) in the slot.
const { locale, title } = Astro.props as { locale: Locale; title: Key };
const t = useT(locale);
---

<section class="mx-auto max-w-[1440px] px-4 pt-36 pb-28 sm:px-8 lg:pt-44">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h1 class="display text-[clamp(3rem,6vw,5.5rem)]">{t(title)}</h1>
      <p class="mt-6 text-muted">{t('legal.draft')}</p>
    </div>
    <article class="legal glass-strong rounded-3xl p-7 sm:p-10 lg:col-span-8">
      <slot />
    </article>
  </div>
</section>
