---
import { site, type Locale } from '../../config/site';
import { useT } from '../../i18n';
import { pressMessage, waLink } from '../../lib/whatsapp';
import BookingForm from './BookingForm.svelte';

const { locale } = Astro.props as { locale: Locale };
const t = useT(locale);
---

<section class="mx-auto max-w-[1440px] px-4 pt-36 pb-28 sm:px-8 lg:pt-44">
  <!-- shortcut: size fitted to "Contratación" (~7.9em in Archivo 125/850); refit if the title changes -->
  <h1 class="display text-[min(calc((100vw-4rem)/8.2),10rem)]">{t('book.title')}</h1>
  <p class="reveal mt-6 max-w-2xl text-xl" style="--d:80ms">{t('book.lede')}</p>
  <div class="mt-12 grid gap-10 lg:grid-cols-12">
    <!-- Builds the request and opens WhatsApp Business (wa.me click-to-chat). No backend, no email. -->
    <div class="reveal lg:col-span-7" style="--d:120ms">
      <BookingForm client:visible {locale} />
    </div>
    <div class="grid h-fit gap-4 lg:col-span-4 lg:col-start-9">
      <div class="glass reveal rounded-3xl p-6" style="--d:160ms">
        <h2 class="font-semibold text-acid-ink">WhatsApp Business</h2>
        <a target="_blank" rel="noopener" href={waLink()} class="mt-1 block text-2xl font-bold hover:text-acid-ink">{site.contact.display}</a>
        <p class="mt-2 text-muted">{t('c.hours')}</p>
      </div>
      <a target="_blank" rel="noopener" href={waLink(pressMessage(locale))} class="press glass reveal rounded-3xl p-6 hover:bg-ink/10" style="--d:200ms">
        <span class="block font-semibold text-acid-ink">{t('press.title')}</span>
        <span class="mt-1 block text-lg">{t('c.press')}</span>
      </a>
      <a
        href={site.press.pdf(locale)}
        target="_blank"
        rel="noopener"
        class="press reveal rounded-full bg-ink px-6 py-4 text-center font-semibold text-ground hover:bg-acid hover:text-on-acid"
        style="--d:320ms">{t('press.kit')}</a
      >
    </div>
  </div>
  <!-- FAQ: same questions as the JSON-LD FAQPage of this page (src/lib/seo.ts), from site.faq. -->
  <section class="mt-28" aria-labelledby="faq-h">
    <h2 id="faq-h" class="display text-[clamp(2.5rem,5vw,4.5rem)]">{t('faq.title')}</h2>
    <div class="mt-8 grid gap-3 lg:max-w-4xl">
      {
        site.faq.map((id) => (
          <details class="glass group rounded-2xl p-5 sm:p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
              {t(`faq.${id}.q`)}
              <span aria-hidden="true" class="text-acid-ink text-2xl leading-none transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-muted">{t(`faq.${id}.a`)}</p>
          </details>
        ))
      }
    </div>
  </section>
</section>
