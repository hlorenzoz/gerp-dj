---
import { getLocale, useT } from '../i18n';

const t = useT(getLocale(Astro.currentLocale));
---

<!-- "On" means dark. The head script in BaseLayout owns `data-theme`; this only flips and stores it. -->
<button
  type="button"
  role="switch"
  aria-checked="true"
  aria-label={t('ui.theme')}
  data-theme-toggle
  class="theme-toggle press grid min-h-11 min-w-11 shrink-0 place-items-center rounded-full"
>
  <span class="relative flex h-9 items-center gap-2 rounded-full border border-ink/25 p-[3px]">
    <span class="knob absolute top-[3px] left-[3px] size-7 rounded-full bg-acid" aria-hidden="true"></span>
    <svg class="sun relative size-7 p-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="moon relative size-7 p-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z"></path>
    </svg>
  </span>
</button>

<style>
  .knob {
    transform: translateX(2.25rem);
    transition: transform 200ms ease;
  }
  .moon {
    color: var(--color-on-acid);
  }
  :global(:root[data-theme='light']) .knob {
    transform: none;
  }
  :global(:root[data-theme='light']) .sun {
    color: var(--color-on-acid);
  }
  :global(:root[data-theme='light']) .moon {
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .knob {
      transition: none;
    }
  }
  /* Without JS (no data-theme) or without light-dark() the switch could not do anything: hide it. */
  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }
  @supports not (color: light-dark(#000, #fff)) {
    .theme-toggle {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const system = matchMedia('(prefers-color-scheme: light)');
  const sync = () => {
    const dark = String(root.dataset.theme !== 'light');
    for (const b of document.querySelectorAll('[data-theme-toggle]')) b.setAttribute('aria-checked', dark);
  };
  sync();
  new MutationObserver(sync).observe(root, { attributeFilter: ['data-theme'] });
  // Delegated: the mobile menu copy lives inside a hydrated island.
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('[data-theme-toggle]')) return;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    try {
      // Picking the system scheme again means "follow the system": forget the override instead of pinning it.
      if (next === (system.matches ? 'light' : 'dark')) localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {
      // Storage blocked: the theme still applies for this page view.
    }
    root.dataset.theme = next;
  });
</script>
