---
import { site, type Locale } from '../../config/site';
import { localizePath, useT } from '../../i18n';
import { serviceMessages, waLink } from '../../lib/whatsapp';
import { getShows } from '../features/data';
import HomeFeatures from '../features/HomeFeatures.astro';
import NextShowCountdown from '../features/NextShowCountdown.svelte';
import Picture from '../Picture.astro';
import AvailabilityForm from './AvailabilityForm.svelte';
import LoopVideo from './LoopVideo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const bookHref = localizePath('/contratacion', locale);
const videoLabels = { pause: t('ui.pause'), play: t('ui.play') };

const services = ([['svc.1.t', 'svc.1.d'], ['svc.2.t', 'svc.2.d'], ['svc.3.t', 'svc.3.d'], ['svc.4.t', 'svc.4.d']] as const).map(
  ([title, text], i) => ({ title: t(title), text: t(text), href: waLink(serviceMessages[locale][i]) }),
);
// While a tour is on and has an upcoming date, the hero shows the next-show countdown instead of the availability check.
const next = site.features.tour ? (await getShows(locale)).next : undefined;
const kit = (['kit.1', 'kit.2', 'kit.3', 'kit.4', 'kit.5'] as const).map(t);
---

<!-- Hero: the client's own footage (village fiesta) as a muted loop -->
<section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden pt-24 pb-10 sm:pb-14">
  <!-- Still frame first: paints immediately, the video fades in over it once it is actually playing. -->
  <div class="absolute inset-0 -z-10">
    <Picture
      name="gerp-dj-fiesta-aldea-ourense"
      alt=""
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="size-full object-cover"
    />
  </div>
  <LoopVideo
    id="hero-video"
    mode="hero"
    src="/videos/gerp-dj-fiesta-aldea-ourense.mp4"
    poster="/images/gerp-dj-fiesta-aldea-ourense-848.webp"
    labels={videoLabels}
    class="absolute inset-0 -z-10 size-full object-cover transition-opacity duration-700"
    buttonClass="right-4 top-20 sm:right-8 sm:top-24"
  />
  <div class="absolute inset-0 -z-10 bg-ground/45"></div>
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-8">
    <!-- shortcut: font-size fitted by hand to Archivo 125/850 ("GERP DJ" ~5.7em wide); use an SVG/fit script if the wordmark changes -->
    <h1 class="display reveal text-[min(calc((100vw-4rem)/5.9),14.5rem)]">{site.name}</h1>
  </div>
  <div class="mx-auto mt-8 grid w-full max-w-[1440px] gap-8 px-4 sm:px-8 lg:grid-cols-12 lg:items-end">
    <div class="min-w-0 lg:col-span-7">
      <p class="reveal max-w-xl text-xl text-ink sm:text-2xl" style="--d:80ms">{t('hero.lede')}</p>
      <div class="reveal mt-8 flex flex-wrap gap-3" style="--d:160ms">
        <a href={bookHref} class="press rounded-full bg-acid px-7 py-4 text-lg font-semibold text-ground hover:bg-ink"
          >{t('cta.bookFull')}</a
        >
        <a
          href={waLink()}
          target="_blank"
          rel="noopener"
          class="press glass rounded-full px-7 py-4 text-lg font-semibold hover:bg-ink/15">{t('cta.wa')}</a
        >
      </div>
    </div>
    <!-- Availability check: the live element while no tour is planned. Builds a WhatsApp question. -->
    <div class="reveal min-w-0 lg:col-span-5 lg:col-start-8" style="--d:240ms">
      {
        next ? (
          <NextShowCountdown client:idle locale={locale} target={next.ms} now={Date.now()} where={next.where} when={next.when} href={next.href} external={next.external} />
        ) : (
          <AvailabilityForm client:idle locale={locale} />
        )
      }
    </div>
  </div>
</section>

<!-- Services: Ourense first -->
<section id="servicios" class="mx-auto max-w-[1440px] scroll-mt-20 px-4 py-28 sm:px-8 lg:py-40" aria-labelledby="svc-h">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 id="svc-h" class="display reveal text-[clamp(3rem,5.5vw,5rem)]">{t('svc.title')}</h2>
      <p class="reveal mt-6 text-xl" style="--d:70ms">{t('svc.lede')}</p>
      <div class="reveal mt-8 hidden lg:block" style="--d:140ms">
        <Picture
          name="gerp-dj-ourense-controladora-denon-dj"
          alt={t('svc.alt')}
          sizes="(min-width: 1024px) 30vw, 100vw"
          class="aspect-[4/3] w-full rounded-3xl object-cover"
        />
      </div>
    </div>
    <ul class="grid gap-3 lg:col-span-7 lg:col-start-6">
      {
        services.map((s) => (
          <li class="glass grid gap-4 rounded-3xl p-6 sm:grid-cols-[1fr_auto] sm:items-center sm:p-7">
            <div>
              <h3 class="text-2xl font-bold">{s.title}</h3>
              <p class="mt-1 text-muted">{s.text}</p>
            </div>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="press justify-self-start rounded-full bg-acid px-6 py-3 font-semibold text-ground hover:bg-ink"
            >
              {t('ui.quote')}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- In action: the client's own footage (terrace session) -->
<section id="en-accion" class="mx-auto max-w-[1440px] scroll-mt-20 px-4 py-28 sm:px-8 lg:py-40" aria-labelledby="action-h">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
    <h2 id="action-h" class="display reveal text-[clamp(3rem,8vw,7.5rem)] lg:col-span-7">{t('action.title')}</h2>
    <p class="reveal text-xl lg:col-span-5" style="--d:70ms">{t('action.p')}</p>
  </div>
  <div class="mt-10 grid gap-6 lg:grid-cols-12">
    <figure class="reveal relative isolate overflow-hidden rounded-3xl lg:col-span-8">
      <LoopVideo
        id="action-video"
        mode="visible"
        src="/videos/gerp-dj-sesion-terraza-ourense.mp4"
        poster="/images/gerp-dj-sesion-terraza-ourense-848.webp"
        labels={videoLabels}
        class="aspect-video w-full object-cover"
        buttonClass="right-4 top-4 sm:right-6 sm:top-6"
      />
      <figcaption class="glass absolute inset-x-4 bottom-4 rounded-2xl p-4 sm:inset-x-6 sm:bottom-6">
        <span class="block text-xl font-bold">{t('action.cap')}</span>
        <span class="text-muted">{t('action.capMeta')}</span>
      </figcaption>
    </figure>
    <figure class="reveal relative isolate overflow-hidden rounded-3xl lg:col-span-4" style="--d:90ms">
      <Picture
        name="gerp-dj-fiesta-aldea-ourense"
        alt={t('action.alt2')}
        sizes="(min-width: 1024px) 33vw, 100vw"
        class="aspect-video h-full w-full object-cover lg:aspect-auto"
      />
      <figcaption class="glass absolute inset-x-4 bottom-4 rounded-2xl p-4">
        <span class="block text-xl font-bold">{t('action.cap2')}</span>
        <span class="text-muted">{t('action.cap2Meta')}</span>
      </figcaption>
    </figure>
  </div>
</section>

<!-- Own equipment: shown in the client's photos and videos -->
<section id="equipo" class="scroll-mt-20 py-28 lg:py-40" aria-labelledby="kit-h">
  <div class="mx-auto grid max-w-[1440px] gap-10 px-4 sm:px-8 lg:grid-cols-12 lg:items-center">
    <div class="reveal lg:col-span-5">
      <Picture
        name="gerp-dj-ourense-cabina-iluminacion-led"
        alt={t('kit.alt')}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-[4/5] w-full rounded-3xl object-cover"
      />
    </div>
    <div class="lg:col-span-6 lg:col-start-7">
      <h2 id="kit-h" class="display reveal text-[clamp(3rem,7vw,6.5rem)]">{t('kit.title')}</h2>
      <p class="reveal mt-6 text-xl" style="--d:70ms">{t('kit.p')}</p>
      <ul class="reveal mt-8 grid gap-3 sm:grid-cols-2" style="--d:140ms">
        {
          kit.map((item, i) => (
            <li class:list={['glass rounded-2xl p-5 text-lg font-semibold', i === kit.length - 1 && 'sm:col-span-2']}>{item}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- Hidden features: latest release, upcoming shows, music rail, live sets (each only when its flag is on) -->
<HomeFeatures locale={locale} />

<!-- About teaser -->
<section class="mx-auto max-w-[1440px] px-4 py-28 sm:px-8 lg:py-40" aria-labelledby="about-h">
  <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
    <div class="reveal lg:col-span-5">
      <Picture
        name="gerp-dj-ourense-retrato-equipo-sonido"
        alt={t('about.alt')}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-[4/5] w-full rounded-3xl object-cover object-top"
      />
    </div>
    <div class="lg:col-span-6 lg:col-start-7">
      <h2 id="about-h" class="display reveal text-[clamp(3rem,7vw,6.5rem)]">{t('about.title')}</h2>
      <p class="reveal mt-6 text-xl" style="--d:70ms">{t('about.p1')}</p>
      <p class="reveal mt-4 text-muted" style="--d:100ms">{t('about.story')}</p>
      <dl class="reveal mt-10 grid gap-4 sm:grid-cols-3" style="--d:140ms">
        <div class="glass-subtle rounded-2xl p-5">
          <dt class="text-muted">{t('about.baseK')}</dt><dd class="mt-1 text-lg font-semibold">Ourense</dd>
        </div>
        <div class="glass-subtle rounded-2xl p-5">
          <dt class="text-muted">{t('about.kitK')}</dt><dd class="mt-1 text-lg font-semibold">{t('about.kitV')}</dd>
        </div>
        <div class="glass-subtle rounded-2xl p-5">
          <dt class="text-muted">{t('about.zoneK')}</dt><dd class="mt-1 text-lg font-semibold">{t('about.zoneV')}</dd>
        </div>
      </dl>
      <a
        href={localizePath('/bio', locale)}
        class="press reveal mt-10 inline-block rounded-full bg-ink px-7 py-4 font-semibold text-ground hover:bg-acid"
        style="--d:200ms">{t('about.more')}</a
      >
    </div>
  </div>
</section>

<!-- Booking band -->
<section class="relative isolate py-28 lg:py-40" aria-labelledby="band-h">
  <div class="absolute inset-0 -z-10">
    <Picture name="gerp-dj-sesion-terraza-ourense" alt="" sizes="100vw" class="size-full object-cover" />
  </div>
  <div class="absolute inset-0 -z-10 bg-ground/55"></div>
  <div class="mx-auto grid max-w-[1440px] gap-8 px-4 sm:px-8 lg:grid-cols-12 lg:items-end">
    <h2 id="band-h" class="display reveal text-[clamp(3rem,8vw,7.5rem)] lg:col-span-7">{t('band.title')}</h2>
    <div class="glass-strong reveal rounded-3xl p-7 lg:col-span-5" style="--d:100ms">
      <p class="text-xl">{t('band.p')}</p>
      <a
        href={bookHref}
        class="press mt-6 inline-block rounded-full bg-acid px-7 py-4 font-semibold text-ground hover:bg-ink">{t('band.cta')}</a
      >
    </div>
  </div>
</section>

<!-- WhatsApp channel (replaces an email newsletter: all communication is WhatsApp) -->
<section class="mx-auto max-w-[1440px] px-4 py-28 sm:px-8 lg:py-40" aria-labelledby="news-h">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
    <h2 id="news-h" class="display reveal text-[clamp(2.75rem,6vw,5.5rem)] lg:col-span-7">{t('news.title')}</h2>
    <div class="glass reveal rounded-3xl p-7 lg:col-span-5" style="--d:100ms">
      <p class="text-xl">{t('channel.p')}</p>
      <a
        target="_blank"
        rel="noopener"
        href={site.whatsapp.channelUrl}
        class="press mt-6 inline-block rounded-full bg-acid px-7 py-4 font-semibold text-ground hover:bg-ink"
        >{t('channel.cta')}</a
      >
    </div>
  </div>
</section>
