---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { alternatePath, getLocale, useT } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.currentLocale);
const t = useT(locale);
const { title = t('ui.title'), description = t('meta.description') } = Astro.props;
const site = Astro.site;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07070a" media="(prefers-color-scheme: dark)" />
    <!-- Theme before first paint: the stored choice (ThemeToggle), else the system preference, followed live. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const system = matchMedia('(prefers-color-scheme: light)');
        const stored = () => {
          try {
            const t = localStorage.getItem('theme');
            return t === 'light' || t === 'dark' ? t : null;
          } catch {
            return null;
          }
        };
        const paint = () => {
          for (const m of document.querySelectorAll('meta[name="theme-color"]'))
            m.content = root.dataset.theme === 'light' ? '#f3f2ee' : '#07070a';
        };
        root.dataset.theme = stored() ?? (system.matches ? 'light' : 'dark');
        paint();
        new MutationObserver(paint).observe(root, { attributeFilter: ['data-theme'] });
        system.addEventListener('change', (e) => {
          if (!stored()) root.dataset.theme = e.matches ? 'light' : 'dark';
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      site && (
        <>
          <link rel="canonical" href={new URL(path, site)} />
          <link rel="alternate" hreflang="es" href={new URL(alternatePath(path, 'es'), site)} />
          <link rel="alternate" hreflang="gl" href={new URL(alternatePath(path, 'gl'), site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternatePath(path, 'es'), site)} />
        </>
      )
    }
    <Font cssVariable="--font-archivo" />
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <!-- Ambient layer: gives every glass surface something to blur. -->
    <div aria-hidden="true" class="fixed inset-0 -z-10">
      <img src="/images/gerp-dj-luces-fiesta-ourense-848.webp" alt="" class="size-full scale-110 object-cover opacity-35 blur-sm" />
      <div class="absolute inset-0 bg-ground/70"></div>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-acid focus:px-4 focus:py-2 focus:text-on-acid"
      >{t('skip')}</a
    >

    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      document.documentElement.classList.add('js');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal:not(.in)').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
